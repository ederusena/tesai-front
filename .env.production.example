# =============================================================
# Spark Vendas — Variáveis de PRODUÇÃO
# Copie este arquivo para .env.production e preencha os valores
# NUNCA comite o .env.production no git
# =============================================================

# ── Domínio ──────────────────────────────────────────────────
# Sem https:// e sem barra no final
DOMAIN=seudominio.com.br

# ── Banco de Dados Spark Vendas ───────────────────────────────
DB_USER=spark_admin
DB_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI
DB_NAME=spark_vendas_db

# ── Redis Spark Vendas ────────────────────────────────────────
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI

# ── Evolution API ─────────────────────────────────────────────
EVO_API_KEY=TROQUE_POR_CHAVE_FORTE_AQUI
EVO_DB_USER=evo_user
EVO_DB_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI
EVO_DB_NAME=evolution_db

# ── WhatsApp ──────────────────────────────────────────────────
# Número do admin (formato: DDI+DDD+número, sem +)
WHATSAPP_ADMIN_NUMBER=5545999999999
